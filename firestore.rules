rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@smpn102.sch.id' ||
        request.auth.token.email == 'admin.btq@smpn102.sch.id' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // System connectivity health check
    match /test/{document=**} {
      allow read, write: if true;
    }

    // Groups: Readable for public student profiles, writable only by admin
    match /groups/{groupId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(groupId);
    }

    // Students: Readable for public student profile/QR lookup, writable only by authenticated users
    match /students/{studentId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(studentId);
    }

    // Users (Mentors / Admins accounts): Writable only by admin
    match /users/{userId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(userId);
    }

    // Student Attendance: Readable for public progress/card, writable only by authenticated mentors/admins
    match /student_attendance/{attendanceId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(attendanceId);
    }

    // Mentor Attendance: Internal staff attendance, accessible only by authenticated users
    match /mentor_attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(attendanceId);
    }

    // Student Learning Progress: Readable for public charts, writable only by authenticated mentors/admins
    match /student_progress/{progressId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(progressId);
    }

    match /progress/{progressId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(progressId);
    }

    // Teaching Journals: Internal KBM records, readable and writable only by authenticated mentors/admins
    match /teaching_journals/{journalId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(journalId);
    }

    // Student Certifications: Readable for verification, writable only by authenticated mentors/admins
    match /certifications/{certId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(certId);
    }

    // Notifications: Readable by all, writable only by authenticated staff
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(notificationId);
    }

    // System Activities: Readable and writable only by authenticated users
    match /system_activities/{activityId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(activityId);
    }

    // Mentors directory: Writable only by admin
    match /mentors/{mentorId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(mentorId);
    }

    // Settings (School Config): Readable for all, writable only by admin
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit Logs: Readable and writable only by authenticated users
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(logId);
    }

    // Academic Holidays: Readable for all, writable only by authenticated users
    match /academic_holidays/{holidayId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(holidayId);
    }
  }
}

