rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isUnseeded() {
      return !exists(/databases/$(database)/documents/system_metadata/migration_status);
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@smpn102.sch.id' ||
        request.auth.token.email == 'admin.btq@smpn102.sch.id' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // System connectivity health check
    match /test/{document=**} {
      allow read, write: if true;
    }

    // System metadata & migration status
    match /system_metadata/{document=**} {
      allow read: if true;
      allow write: if isUnseeded() || isSignedIn();
    }

    // Groups: Readable for all, writable when unseeded or by admin/staff
    match /groups/{groupId} {
      allow read: if true;
      allow write: if (isUnseeded() || isSignedIn()) && isValidId(groupId);
    }

    // Students: Readable for all (profiles & QR cards), writable when unseeded or by authenticated users
    match /students/{studentId} {
      allow read: if true;
      allow write: if (isUnseeded() || isSignedIn()) && isValidId(studentId);
    }

    // Users (Mentors / Admins accounts): Writable when unseeded or by admin
    match /users/{userId} {
      allow read: if true;
      allow write: if (isUnseeded() || isSignedIn()) && isValidId(userId);
    }

    // Mentors directory
    match /mentors/{mentorId} {
      allow read: if true;
      allow write: if (isUnseeded() || isSignedIn()) && isValidId(mentorId);
    }

    // Grades / Curriculums
    match /grades/{gradeId} {
      allow read: if true;
      allow write: if (isUnseeded() || isSignedIn()) && isValidId(gradeId);
    }

    // Student Attendance: Readable for progress & cards, writable by authenticated staff or unseeded
    match /student_attendance/{attendanceId} {
      allow read: if true;
      allow write: if (isUnseeded() || isSignedIn()) && isValidId(attendanceId);
    }

    // Mentor Attendance: Staff attendance
    match /mentor_attendance/{attendanceId} {
      allow read: if true;
      allow write: if (isUnseeded() || isSignedIn()) && isValidId(attendanceId);
    }

    // Student Learning Progress
    match /student_progress/{progressId} {
      allow read: if true;
      allow write: if (isUnseeded() || isSignedIn()) && isValidId(progressId);
    }

    match /progress/{progressId} {
      allow read: if true;
      allow write: if (isUnseeded() || isSignedIn()) && isValidId(progressId);
    }

    // Teaching Journals: KBM records
    match /teaching_journals/{journalId} {
      allow read: if true;
      allow write: if (isUnseeded() || isSignedIn()) && isValidId(journalId);
    }

    // Student Certifications
    match /certifications/{certId} {
      allow read: if true;
      allow write: if (isUnseeded() || isSignedIn()) && isValidId(certId);
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if (isUnseeded() || isSignedIn()) && isValidId(notificationId);
    }

    // System Activities & Audit Logs
    match /system_activities/{activityId} {
      allow read: if true;
      allow write: if (isUnseeded() || isSignedIn()) && isValidId(activityId);
    }

    match /audit_logs/{logId} {
      allow read: if true;
      allow write: if (isUnseeded() || isSignedIn()) && isValidId(logId);
    }

    // Settings (School Config)
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isUnseeded() || isSignedIn();
    }

    // Academic Holidays
    match /academic_holidays/{holidayId} {
      allow read: if true;
      allow write: if (isUnseeded() || isSignedIn()) && isValidId(holidayId);
    }
  }
}
